# ─── Node / npm ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
*.tsbuildinfo

# ─── Build output ────────────────────────────────────────────────────
app/dist/
desktop/release/
desktop/build/icon.iconset/
app/vite.config.js.timestamp-*.mjs

# ─── Live data — never commit ────────────────────────────────────────
# Each install keeps its own relationships, todos, notes, settings.
# app/data/ holds the dev SQLite DB (cadence.db + WAL/journal siblings)
# plus anything else the standalone-dev backend writes into DATA_DIR.
app/data/

# Backend settings (encrypted secrets — Anthropic key, Telegram session,
# Granola key). Lives in user app data on packaged installs; standalone
# dev writes it into app/data/ (covered above) — gitignore the filename
# as a belt-and-braces wherever it lands.
cadence-settings.dat

# Warm-start sweep cache (chat excerpts — private, regenerated on every
# sweep). Packaged installs keep it in user app data; dev in app/data/.
telegram-cache.json

# ─── Logs ────────────────────────────────────────────────────────────
*.log

# ─── OS / IDE ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Misc test probes / one-off scratch ─────────────────────────────
.write-probe-*.txt

# Sandbox-written commit message scratch files. Claude writes one when a
# multi-line message would otherwise have to be pasted into the terminal.
# `git commit -F <file>` reads then the script removes it. Ignored so a
# stale one doesn't get auto-staged.
.*-msg.tmp
.*-commit-msg.tmp

# ─── Electron-builder cache ──────────────────────────────────────────
desktop/dist/

# ─── Mobile (Expo) ───────────────────────────────────────────────────
mobile/.expo/
mobile/dist/
