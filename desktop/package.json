{
  "name": "cadence-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Cadence desktop shell (Electron)",
  "author": "Marlon",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild",
    "dist": "npm --prefix ../app run build && electron-builder",
    "dist:universal": "npm --prefix ../app run build && electron-builder --mac --universal",
    "import-pipewise": "ELECTRON_RUN_AS_NODE=1 electron scripts/import-pipewise.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0",
    "telegram": "^2.20.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.montyinc.cadence",
    "productName": "Cadence",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*.js"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "frontend"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    }
  }
}
