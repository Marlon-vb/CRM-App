{
  "expo": {
    "name": "Cadence",
    "slug": "cadence",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1626"
    },
    "scheme": "cadence",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "ios": {
      "bundleIdentifier": "com.montyinc.cadence",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tg",
          "telegram"
        ],
        "NSCameraUsageDescription": "Cadence scans the setup code shown in the Mac app's Settings."
      }
    },
    "android": {
      "package": "com.montyinc.cadence"
    }
  }
}
